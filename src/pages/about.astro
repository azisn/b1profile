---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, ShieldCheck, Zap, SlidersHorizontal, Users } from "@lucide/astro";

const timeline = [
  {
    version: "v0.1",
    date: "Juni 2026",
    title: "Proof of Concept (PoC)",
    desc: "Prototipe pertama: sinkronisasi satu arah (one-way sync) Item Master SAP B1 ke satu toko Shopify. Berhasil menghemat 4 jam kerja manual harian.",
  },
  {
    version: "v0.5",
    date: "Juli 2026",
    title: "Multi-Tenant & Bi-Directional Engine",
    desc: "Pengembangan arsitektur multi-tenant, webhook real-time untuk Sales Order Shopify → SAP, enkripsi kredensial AES-256-GCM, dan autentikasi OAuth.",
  },
  {
    version: "v1.0",
    date: "Agustus 2026",
    title: "Production-Ready Release",
    desc: "Peluncuran resmi: Live dashboard monitoring, Hangfire background queue, deployment Docker, dukungan multi-warehouse routing, dan audit log lengkap.",
  },
  {
    version: "Roadmap",
    date: "Q4 2026",
    title: "Ekspansi Ekosistem & Fitur Lanjutan",
    desc: "Listing publik Shopify App Store, modul Business Partner (BP) Customer Portal tingkat lanjut, dan integrasi Shopify Billing API.",
  },
];
---

<Layout
  title={`Tentang Kami — ${siteConfig.title}`}
  description="Mengenal B1connect: Misi kami menghubungkan ekosistem e-commerce Shopify dengan ERP SAP Business One secara otomatis, aman, dan andal."
>
  <section class="site-container my-12">
    <PageHeader
      title="Menghubungkan Dunia E-Commerce & ERP Enterprise"
      description="B1connect hadir untuk mengeliminasi inefisiensi entri manual, mencegah kesalahan stok barang, dan mempercepat otomatisasi bisnis Anda."
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <article class="space-y-12">

      <!-- Why we built it -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">Mengapa Kami Membangun B1connect</h2>
        <div class="space-y-4 text-neutral-600 dark:text-neutral-300 leading-relaxed">
          <p>
            Banyak perusahaan retail, distributor, dan brand modern di Indonesia mengandalkan <strong>SAP Business One</strong> sebagai tulang punggung ERP keuangan serta pergudangan mereka, sekaligus memilih <strong>Shopify</strong> sebagai platform penjualan online terbaik.
          </p>
          <p>
            Namun kenyataannya, jurang pemisah antara kedua sistem tersebut sering kali masih dijembatani dengan proses manual yang melelahkan: staf admin harus mengetik ulang puluhan invoice order setiap hari, mengunduh dan mengunggah spreadsheet CSV, serta berhadapan dengan komplain pelanggan akibat selisih stok fisik di gudang (overselling).
          </p>
          <p>
            Membangun sistem integrasi kustom dari nol memerlukan biaya ratusan juta, waktu berbulan-bulan, serta beban maintenance yang rumit. <strong>B1connect</strong> diciptakan sebagai jawaban: solusi middleware siap pakai berbasis Service Layer resmi SAP B1 yang aman, tangguh, multi-tenant, dan siap berjalan dalam hitungan jam.
          </p>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Values -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">Prinsip & Nilai yang Kami Pegang</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <ShieldCheck class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Keamanan Tanpa Kompromi</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Seluruh kredensial SAP dan token Shopify dienkripsi dengan standar militer AES-256-GCM. Isolasi tenant menjamin data bisnis Anda aman.</p>
          </div>
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Zap class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Keandalan Tinggi (High Reliability)</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Sistem background worker Hangfire dengan antrean fail-safe dan auto-retry memastikan tidak ada order yang terlewat saat jaringan sibuk.</p>
          </div>
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <SlidersHorizontal class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Kemudahan Konfigurasi</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Setup wizard 3 langkah yang intuitif tertanam langsung di Shopify Admin tanpa perlu coding atau modifikasi core SAP.</p>
          </div>
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Users class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Dukungan Nyata Ahli ERP</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Didukung oleh tim teknis yang memahami arsitektur ERP SAP Business One dan e-commerce untuk membantu bisnis Anda berkembang.</p>
          </div>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Timeline -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">Perjalanan Produk Kami</h2>
        <div class="relative">
          <div class="absolute left-3 md:left-4 top-1.5 bottom-1.5 w-px bg-neutral-200 dark:bg-neutral-700"></div>
          <ol class="space-y-8">
            {timeline.map((item, i) => (
              <li class="relative pl-10 md:pl-12" data-aos="fade-up-sm" data-aos-delay={i * 80} data-aos-once="true">
                <div class="absolute left-1.5 md:left-2.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
                <div class="mb-1 flex items-center gap-3 flex-wrap">
                  <Badge variant="primary" size="sm">{item.version}</Badge>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">{item.date}</span>
                </div>
                <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-1">{item.title}</h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Call to Action -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">Siap Mengoptimalkan Operasional Bisnis Anda?</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
          Hubungi kami sekarang untuk mendiskusikan integrasi sistem Anda atau jadwalkan demonstrasi langsung bersama engineer kami.
        </p>
      </div>

      <div class="flex flex-wrap gap-4" data-aos="fade-up-xs" data-aos-delay="200" data-aos-once="true">
        <Button url="/contact" type="fill">
          Hubungi Kami <ArrowRight size={16} class="ml-1" />
        </Button>
        <Button url="/changelog">
          Lihat Catatan Rilis
        </Button>
      </div>
    </article>
  </section>
</Layout>
