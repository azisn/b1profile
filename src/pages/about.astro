---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, ShieldCheck, Zap, SlidersHorizontal, Users } from "@lucide/astro";

const timeline = [
  {
    version: "v1.0",
    date: "August 2026",
    title: "Production Release: Shopify × SAP B1 (Live)",
    desc: "Official enterprise launch: sub-second webhooks for orders, 30-second inventory delta sync, AES-256-GCM encryption, and multi-warehouse routing.",
  },
  {
    version: "v1.5",
    date: "Q4 2026",
    title: "Canonical Schema & Telemetry Mesh",
    desc: "Architectural decoupling into canonical commerce models, live transaction telemetry streaming, and automated self-healing error diagnostics.",
  },
  {
    version: "v2.0",
    date: "Q1 2027",
    title: "Universal ERP Expansion: S/4HANA & NetSuite",
    desc: "Expanding beyond SAP B1 with dedicated connectors for SAP S/4HANA (OData v4) and Oracle NetSuite (SuiteTalk REST), orchestrated through unified tenant configs.",
  },
  {
    version: "v2.5",
    date: "Q2 2027",
    title: "Omnichannel Commerce Mesh: WooCommerce & Marketplaces",
    desc: "Native connectors for WooCommerce, Adobe Commerce/Magento, and direct marketplace pipelines (Amazon SP-API & TikTok Shop) connected into any supported ERP.",
  },
];
---

<Layout
  title={`About Us — ${siteConfig.title}`}
  description="About B1connect: Building the universal integration mesh between modern commerce platforms and enterprise ERP systems."
>
  <section class="site-container my-12">
    <PageHeader
      title="The Integration Mesh for Modern Commerce & Enterprise ERP"
      description="B1connect eliminates manual operational friction, unifies fragmented commerce channels, and powers automated data synchronization at global scale."
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <article class="space-y-12">

      <!-- Why we built it -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">Our Vision & Architecture</h2>
        <div class="space-y-4 text-neutral-600 dark:text-neutral-300 leading-relaxed">
          <p>
            Modern retail enterprises, international distributors, and high-growth consumer brands rely on robust enterprise ERPs as their operational backbone for accounting and warehouse management, while deploying agile storefronts for world-class customer experiences.
          </p>
          <p>
            We started with a laser-focused flagship engine: <strong>Shopify × SAP Business One</strong>, solving the acute pain of desynchronized inventories, manual order re-keying, and pricing latency for organizations that demand bulletproof reliability.
          </p>
          <p>
            Building upon this production foundation, our broader mission is to deliver the <strong>Universal Integration Mesh</strong>. By architecting a decoupled canonical commerce abstraction layer, B1connect is expanding into a comprehensive platform where any modern digital sales channel—from Shopify and WooCommerce to global marketplaces—connects seamlessly with any enterprise ERP including SAP S/4HANA, Oracle NetSuite, and Microsoft Dynamics 365.
          </p>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Values -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">Our Core Principles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <ShieldCheck class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Uncompromising Security</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">All SAP credentials and Shopify tokens are encrypted using AES-256-GCM. Strict tenant isolation ensures zero cross-merchant data leakage.</p>
          </div>
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Zap class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">High Availability & Resilience</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Hangfire-backed worker queues with automated exponential backoff retries guarantee that not a single order is dropped during network surges.</p>
          </div>
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <SlidersHorizontal class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Intuitive Configuration</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">A 3-step setup wizard embedded directly into Shopify Admin connects your ERP without requiring custom scripts or invasive SAP modifications.</p>
          </div>
          <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Users class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">Deep ERP Expertise</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Supported by engineering teams with deep expertise in SAP Business One architecture and high-volume e-commerce scaling.</p>
          </div>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Timeline -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">Our Product Journey</h2>
        <div class="relative">
          <div class="absolute left-3 md:left-4 top-1.5 bottom-1.5 w-px bg-neutral-200 dark:bg-neutral-700"></div>
          <ol class="space-y-8">
            {timeline.map((item, i) => (
              <li class="relative pl-10 md:pl-12" data-aos="fade-up-sm" data-aos-delay={i * 80} data-aos-once="true">
                <div class="absolute left-1.5 md:left-2.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
                <div class="mb-1 flex items-center gap-3 flex-wrap">
                  <Badge variant="primary" size="sm">{item.version}</Badge>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">{item.date}</span>
                </div>
                <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-1">{item.title}</h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Call to Action -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">Ready to Modernize Your Operations?</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
          Contact our team today to evaluate your system architecture or schedule a direct demonstration.
        </p>
      </div>

      <div class="flex flex-wrap gap-4" data-aos="fade-up-xs" data-aos-delay="200" data-aos-once="true">
        <Button url="/contact" type="fill">
          Get in Touch <ArrowRight size={16} class="ml-1" />
        </Button>
        <Button url="/changelog">
          View Changelog
        </Button>
      </div>
    </article>
  </section>
</Layout>
