---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Clock3, LifeBuoy, Mail, MapPin, Phone, Send, Sparkles, ShieldCheck } from "@lucide/astro";

const contactTopics = [
  { value: "demo", label: "Request a Live Demo (Shopify × SAP B1)" },
  { value: "request-connector", label: "Request a New Connector (Vote for your ERP or Platform)" },
  { value: "custom-integration", label: "Bespoke Enterprise Integration Architecture" },
  { value: "technical", label: "Technical Architecture / API Query" },
  { value: "partnership", label: "ERP Consultancy or Reseller Partnership" },
  { value: "general", label: "General Inquiries" },
];

const channels = [
  {
    icon: Mail,
    label: "Official Email",
    text: siteConfig.mail,
    href: `mailto:${siteConfig.mail}`,
  },
  {
    icon: Phone,
    label: "Direct Consultation / WhatsApp",
    text: "+62 812-8800-9922",
    href: "https://wa.me/6281288009922",
  },
  {
    icon: MapPin,
    label: "Headquarters",
    text: "Jakarta, Indonesia & Global Remote",
    href: "https://maps.google.com",
  },
];

const expectations = [
  { icon: Clock3, title: "Rapid Response", desc: "All inquiries and demo requests receive a response within 1 business day." },
  { icon: LifeBuoy, title: "Live Architecture Demo", desc: "Book an interactive session via Google Meet to walk through live product and order flows." },
  { icon: ShieldCheck, title: "Strict Confidentiality", desc: "We are glad to execute mutual NDAs prior to reviewing your internal ERP architecture." },
];
---

<Layout
  title={`Contact & Architecture Consultation — ${siteConfig.title}`}
  description="Discuss your commerce and ERP integration requirements, request upcoming connectors, or book a live demo."
>
  <main class="site-container py-12 md:py-20">
    <section class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(420px,1.1fr)] lg:items-start">
      <div data-aos="fade-up-xs" data-aos-once="true">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/15 bg-primary/5 px-3 py-1 text-xs font-medium text-primary dark:border-primary-light/20 dark:bg-primary-light/10 dark:text-primary-light">
          <Sparkles size={14} />
          Architecture & Consultation
        </p>
        <h1 class="max-w-xl font-brand text-4xl leading-tight tracking-normal text-neutral-800 dark:text-neutral-100 sm:text-5xl lg:text-6xl">
          Let's Architect Your Integration.
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
          Have questions about SAP Service Layer compatibility, want to request an upcoming connector for NetSuite or WooCommerce, or need a bespoke workflow? Our engineering team is ready to assist.
        </p>

        <div class="mt-10 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {channels.map(({ icon: Icon, label, text, href }, index) => (
            <a
              href={href}
              target={href.startsWith("http") ? "_blank" : "_self"}
              class="group flex items-center gap-4 rounded-xl border border-neutral-200 bg-bg-secondary/75 p-4 transition-all hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-[0_14px_35px_rgba(25,34,47,0.08)] dark:border-neutral-700 dark:bg-bg-secondary-dark/75 dark:hover:border-primary-light/35 dark:hover:shadow-[0_14px_35px_rgba(0,0,0,0.22)]"
              data-aos="fade-up-xs"
              data-aos-delay={`${index * 100}`}
              data-aos-once="true"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-primary shadow-sm ring-1 ring-neutral-200/70 transition-colors group-hover:bg-primary group-hover:text-white dark:bg-neutral-900/60 dark:text-primary-light dark:ring-neutral-700 dark:group-hover:bg-primary-light dark:group-hover:text-neutral-950">
                <Icon size={18} />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-neutral-800 dark:text-neutral-100">{label}</span>
                <span class="mt-0.5 block truncate text-sm text-neutral-500 transition-colors group-hover:text-primary dark:text-neutral-400 dark:group-hover:text-primary-light">{text}</span>
              </span>
              <ArrowRight class="ml-auto h-4 w-4 shrink-0 text-neutral-300 transition-all group-hover:translate-x-1 group-hover:text-primary dark:text-neutral-600 dark:group-hover:text-primary-light" />
            </a>
          ))}
        </div>

        <div class="mt-8 border-y border-dashed border-neutral-200 py-6 dark:border-neutral-700" data-aos="fade-up-xs" data-aos-delay="200" data-aos-once="true">
          <div class="grid gap-5">
            {expectations.map(({ icon: Icon, title, desc }) => (
              <div class="flex gap-3">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light">
                  <Icon size={16} /> 
                </span>
                <div>
                  <h2 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">{title}</h2>
                  <p class="mt-1 text-sm leading-6 text-neutral-500 dark:text-neutral-400">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mx-auto w-full max-w-xl lg:max-w-none" data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <div class="rounded-2xl border border-neutral-200 bg-bg-secondary/85 p-5 shadow-[0_18px_60px_rgba(25,34,47,0.08)] backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/85 dark:shadow-[0_18px_60px_rgba(0,0,0,0.22)] sm:p-8">
          <div class="mb-7 flex flex-col gap-4 border-b border-dashed border-neutral-200 pb-6 dark:border-neutral-700 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-primary dark:text-primary-light">Inquiry Form</p>
              <h2 class="mt-2 font-brand text-3xl sm:text-4xl tracking-normal text-neutral-800 dark:text-neutral-100">Send a Message & Request a Demo</h2>
              <p class="mt-2 text-sm leading-6 text-neutral-500 dark:text-neutral-400">
                Fill out the form below and our integration engineers will reach out promptly.
              </p>
            </div>
            <span class="inline-flex w-fit rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              24h Response SLA
            </span>
          </div>

          <form id="contact-form" class="space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Full Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  required
                  placeholder="Jane Doe"
                  class="contact-field"
                />
              </div>

              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Work Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  required
                  placeholder="jane@company.com"
                  class="contact-field"
                />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="company" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Company / Brand Name</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="Acme Retail Corp"
                  class="contact-field"
                />
              </div>

              <div>
                <label for="phone" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Phone / WhatsApp</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="+1 (555) 000-0000"
                  class="contact-field"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Inquiry Topic</label>
              <select id="subject" name="subject" required class="contact-field">
                <option value="">Select your inquiry topic</option>
                {contactTopics.map((topic) => (
                  <option value={topic.value}>{topic.label}</option>
                ))}
              </select>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="platform" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Commerce Platform</label>
                <select id="platform" name="platform" class="contact-field">
                  <option value="shopify">Shopify (Live)</option>
                  <option value="woocommerce">WooCommerce (Pipeline)</option>
                  <option value="magento">Magento / Adobe Commerce</option>
                  <option value="tiktok">TikTok Shop</option>
                  <option value="amazon">Amazon Marketplace</option>
                  <option value="other">Other / Custom API</option>
                </select>
              </div>

              <div>
                <label for="erp" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Target ERP Engine</label>
                <select id="erp" name="erp" class="contact-field">
                  <option value="sap-b1">SAP Business One (Live)</option>
                  <option value="sap-s4hana">SAP S/4HANA (Pipeline)</option>
                  <option value="netsuite">Oracle NetSuite (Pipeline)</option>
                  <option value="dynamics-365">Microsoft Dynamics 365</option>
                  <option value="odoo">Odoo Enterprise</option>
                  <option value="other">Other ERP System</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-medium text-neutral-700 dark:text-neutral-300">Project Details & Requirements</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Tell us about your ERP version, storefront platforms, order volume, or any custom connector requirements..."
                class="contact-field resize-none"
              ></textarea>
            </div>

            <div class="rounded-xl border border-dashed border-primary/20 bg-primary/5 p-4 text-xs sm:text-sm leading-6 text-neutral-600 dark:border-primary-light/20 dark:bg-primary-light/10 dark:text-neutral-300">
              <strong class="font-semibold text-primary dark:text-primary-light">Privacy Guaranteed:</strong> Your contact information is solely used to facilitate B1connect technical consultations.
            </div>

            <div class="form-submit-btn">
              <Button type="fill" className="w-full max-w-none justify-center" url="javascript:void(0);">
                Submit Inquiry <Send size={16} class="ml-1" />
              </Button>
            </div>

            <div id="form-success" class="hidden rounded-xl border border-green-200 bg-green-50 p-4 text-center text-sm font-medium text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-300">
              Thank you! Your message has been received. A B1connect integration specialist will contact you within 1 business day.
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-field {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--color-neutral-200);
    background: color-mix(in srgb, var(--color-bg-secondary) 82%, transparent);
    padding: 0.875rem 1rem;
    color: var(--color-neutral-800);
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .contact-field::placeholder {
    color: var(--color-neutral-400);
  }

  .contact-field:focus {
    border-color: var(--color-primary);
    background: var(--color-bg-secondary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  :global(.dark) .contact-field {
    border-color: var(--color-neutral-700);
    background: color-mix(in srgb, var(--color-bg-secondary-dark) 82%, transparent);
    color: var(--color-neutral-100);
  }

  :global(.dark) .contact-field::placeholder {
    color: var(--color-neutral-500);
  }

  :global(.dark) .contact-field:focus {
    border-color: var(--color-primary-light);
    background: var(--color-bg-secondary-dark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary-light) 18%, transparent);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const submitBtn = form?.querySelector('.form-submit-btn a') as HTMLAnchorElement | null;

  // Pre-select topic from URL parameter if present
  const urlParams = new URLSearchParams(window.location.search);
  const topicParam = urlParams.get('topic');
  if (topicParam) {
    const subjectSelect = document.getElementById('subject') as HTMLSelectElement | null;
    if (subjectSelect) {
      subjectSelect.value = topicParam;
    }
  }

  submitBtn?.addEventListener('click', (event) => {
    event.preventDefault();

    if (!form?.checkValidity()) {
      form?.reportValidity();
      return;
    }

    successMsg?.classList.remove('hidden');
    form.reset();

    setTimeout(() => {
      successMsg?.classList.add('hidden');
    }, 6000);
  });
</script>
