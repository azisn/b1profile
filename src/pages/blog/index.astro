---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import { siteConfig } from "@/config/site";

const POSTS_PER_PAGE = 6;
const currentPage = 1;
---

<Layout title={`Blog & Engineering Insights — ${siteConfig.title}`} description="Technical guides, architecture breakdowns, and ecosystem updates for Shopify and SAP Business One integrations.">
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="Engineering Insights & Integration Guides"
      description="Technical deep dives, best practices, and release updates on connecting Shopify with SAP Business One."
    />
  </section>
  <section class="relative z-20 mx-auto my-12 lg:px-0">
    <div class="mt-12">
      <BlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>
