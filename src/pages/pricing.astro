---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, ShieldCheck, Sparkles, Building2, Layers } from "@lucide/astro";

const pillars = [
  {
    icon: Building2,
    title: "Tailored to Your ERP Architecture",
    desc: "Every enterprise ERP deployment—whether SAP Business One, SAP S/4HANA, NetSuite, or Dynamics 365—features unique chart of accounts, custom UDFs, and warehouse workflows. We tailor every implementation to your environment."
  },
  {
    icon: Layers,
    title: "Pluggable Multi-Channel Licensing",
    desc: "Connect single or multi-tenant storefronts across Shopify and upcoming marketplace connectors with volume-based routing and dedicated throughput tiers."
  },
  {
    icon: ShieldCheck,
    title: "Guaranteed SLA & White-Glove Onboarding",
    desc: "Enterprise deployments include end-to-end sandbox testing, data reconciliation audits, 99.9% uptime SLA commitments, and dedicated engineering support."
  }
];
---

<Layout
  title={`Enterprise Consultation & Access — ${siteConfig.title}`}
  description="Bespoke integration solutions and custom architecture consultations for enterprise commerce and ERP connectivity."
>
  <section class="site-container my-12">
    <PageHeader
      title="Bespoke Architecture. Tailored for Your Enterprise."
      description="We provide custom implementation plans calibrated to your exact ERP infrastructure, transaction throughput, and business rules."
    />
  </section>

  <!-- Consultation Banner Card -->
  <section class="site-container max-w-4xl mx-auto my-8">
    <div class="relative overflow-hidden rounded-3xl border border-primary/20 bg-gradient-to-b from-bg-secondary to-bg-secondary/60 dark:from-bg-secondary-dark dark:to-bg-secondary-dark/60 p-8 md:p-12 text-center shadow-sm">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-semibold text-primary mb-6">
        <Sparkles size={14} />
        Consultative & Enterprise Deployments
      </div>

      <h2 class="text-3xl md:text-4xl font-brand mb-4 text-neutral-900 dark:text-white">
        Looking for a Production-Ready or Custom Connector?
      </h2>
      <p class="text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto mb-8 leading-relaxed text-base">
        Whether you are deploying our battle-tested <strong>Shopify × SAP Business One</strong> engine or requesting upcoming connectors for <strong>NetSuite, Dynamics 365, or multi-marketplace ecosystems</strong>, our engineering team works directly with your technical architects to deliver custom proposals.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <Button url="/contact" type="fill" className="text-base px-8 py-3">
          Book an Architecture Consultation <ArrowRight size={18} class="ml-1.5" />
        </Button>
        <Button url="/#integrations" className="text-base px-8 py-3">
          Explore Integrations Roadmap
        </Button>
      </div>
    </div>
  </section>

  <!-- Value Pillars -->
  <section class="site-container max-w-5xl mx-auto py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pillars.map((pillar) => (
        <div class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
          <div class="w-12 h-12 rounded-xl bg-primary/10 dark:bg-primary/20 flex items-center justify-center text-primary mb-4">
            <pillar.icon class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">{pillar.title}</h3>
          <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{pillar.desc}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>