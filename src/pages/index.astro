---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import FAQ from "@/components/sections/FAQ.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import Button from "@/components/ui/Button.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import TechStackCard from "@/components/cards/TechStackCard.astro";
import { siteConfig } from "@/config/site";
import {
  ShoppingBag, Database, Server, Boxes,
  ShieldCheck, Factory, Package, Globe,
  ArrowRight, LayoutDashboard, Layers, FileText,
  ChartNoAxesColumnIncreasing, Tag, Users, CheckCheck
} from "@lucide/astro";

// FAQ data
const faqItems = [
  {
    question: "Does B1connect support multi-tenant architecture for multiple Shopify stores?",
    answer: "Yes. B1connect is architected with native multi-tenancy. You can connect and manage multiple Shopify storefronts—such as regional branches, sub-brands, or subsidiary brands—orchestrated into a single SAP Business One instance."
  },
  {
    question: "What core data points are synchronized between Shopify and SAP B1?",
    answer: "B1connect synchronizes 5 mission-critical data pipelines: Item Master catalog, Multi-Warehouse Inventory Stock, Price Lists & Currencies, Sales Orders (ORDR documents), and Business Partner (Customer) accounts via instant webhooks and intelligent polling."
  },
  {
    question: "How are our SAP database credentials and tokens secured?",
    answer: "Security is non-negotiable. All SAP Service Layer credentials and Shopify access tokens are encrypted at-rest using AES-256-GCM. Webhooks are cryptographically authenticated via constant-time HMAC-SHA256 signatures, and sessions use JWT."
  },
  {
    question: "Does it support both On-Premise and Cloud SAP B1 (SQL Server & HANA)?",
    answer: "Yes. B1connect interfaces strictly through the official SAP Business One Service Layer REST API, providing native support for on-premise servers, cloud instances, Microsoft SQL Server, and SAP HANA databases."
  },
  {
    question: "How long does deployment and onboarding take?",
    answer: "For merchants with active SAP B1 Service Layer access, typical onboarding takes less than 24-48 hours: install the app, map field attributes via the guided wizard, and execute end-to-end sandbox test transactions."
  },
  {
    question: "Does B1connect require custom add-ons or modifications inside core SAP?",
    answer: "No. B1connect does not require invasive core add-ons or stored-procedure overrides. By leveraging the standard official Service Layer, your ERP remains 100% compliant and fully upgrade-safe for future SAP patches."
  },
];

// Features data
const features = [
  {
    icon: "/assets/icon/structure.png",
    title: "Bidirectional Synchronization",
    desc: "Products, stock levels, and price lists flow seamlessly from SAP B1 to Shopify. Customer checkouts and sales orders flow back into SAP B1 instantly with zero manual entry."
  },
  {
    icon: "/assets/icon/motion.png",
    title: "Enterprise-Grade Security",
    desc: "AES-256-GCM encryption for all secrets at rest. Constant-time HMAC-SHA256 signature verification for Shopify webhooks and JWT-authenticated session tokens."
  },
  {
    icon: "/assets/icon/components.png",
    title: "True Multi-Tenant Engine",
    desc: "A single middleware cluster powers multiple Shopify storefronts and warehouse centers. Complete tenant isolation guarantees zero data leakage."
  },
  {
    icon: "/assets/icon/customize.png",
    title: "Flexible Field Mapping",
    desc: "Configurable mapping for ItemCode to SKU, product attributes, Units of Measure (UoM), and warehouse routing rules without altering backend source code."
  },
  {
    icon: "/assets/icon/document.png",
    title: "Audit Trail & Live Monitoring",
    desc: "Granular telemetry logs for every sync event. Inspect transaction payloads, detect discrepancies with proactive alerts, and trigger instant re-syncs."
  },
  {
    icon: "/assets/icon/fast.png",
    title: "High-Performance Engine",
    desc: "Built on .NET 10, Redis caching, and Hangfire background queues to orchestrate tens of thousands of SKUs and orders with sub-second latency."
  },
];

// Problem cards data
const problems = [
  {
    icon: "/assets/icon/clock.png",
    title: "Manual data entry wastes hours and causes errors",
    desc: "Re-keying customer orders from Shopify into SAP B1 by hand drains hundreds of team hours and inevitably leads to costly typos and misplaced shipments."
  },
  {
    icon: "/assets/icon/battery.png",
    title: "Desynchronized inventory leads to painful overselling",
    desc: "When warehouse stock sells out physically but still displays as available on Shopify, angry customer cancellations and negative store reviews follow."
  },
  {
    icon: "/assets/icon/bell.png",
    title: "Pricing updates in SAP lag behind storefronts",
    desc: "Manual updates across multiple storefronts cause delays when ERP price matrices change, quietly eroding business profit margins on every order."
  },
];

// Use cases
const useCases = [
  { icon: ShoppingBag, label: "Retail & DTC", desc: "Omnichannel Shopify stores connected to SAP B1 fulfillment" },
  { icon: Factory, label: "Manufacturing", desc: "Direct sales fulfilled straight from factory warehouse floors" },
  { icon: Package, label: "B2B Wholesale & Distributors", desc: "High-volume order streams pushed directly into ERP ledgers" },
  { icon: Globe, label: "Multi-Brand Portfolios", desc: "Manage multiple regional Shopify storefronts in one hub" },
  { icon: Boxes, label: "High-SKU Catalogs", desc: "Tens of thousands of SKUs requiring strict stock accuracy" },
  { icon: ShieldCheck, label: "SAP & ERP Consultancies", desc: "Turnkey, dependable integration accelerator for SAP clients" },
];

// Tech stack and ecosystem partners
const logos = [
  { name: "Shopify (Live)", icon: ShoppingBag },
  { name: "SAP B1 (Live)", icon: Database },
  { name: "SAP S/4HANA", icon: Server },
  { name: "Oracle NetSuite", icon: Layers },
  { name: "Dynamics 365", icon: Boxes },
  { name: "WooCommerce", icon: Globe },
];

// Integrations Ecosystem Data
const integrationsCommerce = [
  { name: "Shopify", status: "Live & Production-Ready", live: true, desc: "Bidirectional sync, sub-second webhooks, multi-warehouse inventory." },
  { name: "WooCommerce", status: "In Active Development", live: false, desc: "REST API v3 connector for catalog and order ingestion." },
  { name: "Magento / Adobe Commerce", status: "Pipeline", live: false, desc: "GraphQL & Bulk Async API integration for enterprise storefronts." },
  { name: "TikTok Shop", status: "Pipeline", live: false, desc: "Direct social commerce sync for orders and fast-moving inventory." },
  { name: "Amazon Marketplace", status: "Pipeline", live: false, desc: "Selling Partner SP-API order routing and FBA/FBM balance." },
];

const integrationsErp = [
  { name: "SAP Business One", status: "Live & Production-Ready", live: true, desc: "Official Service Layer REST API for HANA and SQL Server." },
  { name: "SAP S/4HANA", status: "In Active Development", live: false, desc: "Enterprise OData v4 APIs for Cloud and On-Premises editions." },
  { name: "Oracle NetSuite", status: "Pipeline", live: false, desc: "SuiteTalk REST Web Services & custom records synchronization." },
  { name: "Microsoft Dynamics 365", status: "Pipeline", live: false, desc: "Business Central cloud OData & event-driven webhooks." },
  { name: "Odoo Enterprise", status: "Pipeline", live: false, desc: "External REST & XML-RPC APIs for inventory and sales orders." },
];

// Pipelines
const pipelines = [
  { title: "Product Master", direction: "SAP → Shopify", icon: Package, desc: "ItemCode, title, categories, barcodes, and rich descriptions." },
  { title: "Inventory Stock", direction: "SAP → Shopify", icon: Boxes, desc: "Real-time stock level synchronization across multi-warehouse locations." },
  { title: "Price Lists", direction: "SAP → Shopify", icon: Tag, desc: "Multi-currency price lists, tier pricing, and promotional catalogs." },
  { title: "Sales Orders", direction: "Shopify → SAP", icon: ShoppingBag, desc: "Instantly creates compliant ORDR / ODLN documents with line items." },
  { title: "Customer Records", direction: "Shopify ↔ SAP", icon: Users, desc: "Automatic Business Partner (BP) matching and record generation." },
];
---

<Layout
  title={`${siteConfig.title} — Enterprise Commerce & ERP Integration Mesh`}
  description={siteConfig.meta.description}
  keywords={siteConfig.meta.keywords}
>

  <!-- 1. Hero -->
  <HeroSection />

  <!-- 2. Logo / Ecosystem Strip -->
  <section class="py-12 md:py-16 lg:py-20 site-container" data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="400">
    <p class="text-center text-xs sm:text-sm uppercase tracking-wider font-semibold text-neutral-400 dark:text-neutral-500 mb-6">
      Trusted by Modern ERP & E-Commerce Ecosystems
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 md:gap-8">
      {logos.map((logo) => (
        <div class="flex items-center gap-2 px-4 py-2.5 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-xl bg-bg-secondary/40 dark:bg-bg-secondary-dark/40 shadow-xs hover:border-primary/40 transition-colors">
          <logo.icon class="w-4 h-4 text-primary" />
          <span class="text-xs sm:text-sm font-semibold tracking-wide text-neutral-700 dark:text-neutral-200">{logo.name}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. Problem Statement -->
  <section class="py-16 md:py-24 site-container">
    <SectionHeader
      title="Operational Bottlenecks Without Automated Integration"
      description="Managing Shopify storefronts and SAP B1 ERP in silos cripples your team's operational throughput."
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      {problems.map((problem, i) => (
        <div
          class="p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 shadow-xs hover:shadow-md transition-all duration-300"
          data-aos="fade-up-sm"
          data-aos-delay={i * 100}
          data-aos-once="true"
        >
          <img
            src={problem.icon}
            alt={problem.title}
            loading="lazy"
            width="64"
            height="64"
            class="w-14 h-14 mb-4 object-contain"
          />
          <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">{problem.title}</h3>
          <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{problem.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. Solution / 5 Core Pipelines -->
  <section class="py-12 md:py-16 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">Bidirectional Synchronization Architecture</h2>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
        B1connect bridges Shopify with SAP Business One via official Service Layer APIs. All critical commerce data flows automatically without altering core SAP logic.
      </p>
    </div>

    <!-- Pipeline cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {pipelines.map((p, i) => (
        <div
          class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 flex flex-col justify-between hover:-translate-y-1 hover:shadow-md transition-all duration-300"
          data-aos="fade-up-xs"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-primary/10 dark:bg-primary/20 flex items-center justify-center text-primary mb-3">
              <p.icon class="w-5 h-5" />
            </div>
            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wide bg-blue-500/10 text-blue-600 dark:text-blue-400 mb-2">
              {p.direction}
            </span>
            <h3 class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-1">{p.title}</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">{p.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-dashed border-primary/10 dark:border-neutral-700 flex items-center text-[11px] font-medium text-emerald-600 dark:text-emerald-400 gap-1.5">
            <CheckCheck class="w-3.5 h-3.5" />
            <span>Automated Flow</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-8 site-container"></div>

  <!-- 5. Features Grid -->
  <section class="py-16 md:py-24 site-container">
    <SectionHeader
      title="Engineered for Scalability and High Throughput"
      description="A modern middleware foundation delivering enterprise stability, cryptographic security, and intuitive configuration."
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {features.map((feature, i) => (
        <div
          data-aos="fade-up-sm"
          data-aos-delay={i * 100}
          data-aos-once="true"
          class="h-full"
        >
          <div
            class="h-full p-6 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border transition-all duration-300 ease-in-out border-primary/10 dark:border-neutral-700 hover:shadow-md hover:-translate-y-1"
          >
            <img
              src={feature.icon}
              alt={feature.title}
              loading="lazy"
              width="64"
              height="64"
              class="w-14 h-14 mb-4 object-contain"
            />
            <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">{feature.title}</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{feature.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 6. Product Preview - Dashboard Mock -->
  <section class="py-16 md:py-24 site-container" data-aos="fade-up-sm" data-aos-once="true">
    <SectionHeader
      title="Real-Time Sync Observability & Event Stream"
      description="Monitor order cycles, inventory mutations, and SAP B1 Service Layer health metrics transparently from a unified control plane."
    />
    <div class="mt-8 max-w-4xl mx-auto" data-aos="fade-up-sm" data-aos-once="true" data-aos-delay="300">
      <BrowserFrame url="app.b1connect.id/sync/monitor">
        <div class="flex h-[320px] md:h-[400px]">
          <!-- Sidebar -->
          <aside class="hidden sm:flex flex-col w-14 md:w-16 border-r border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-900/40 py-4 px-2 md:px-3 gap-2">
            <div class="w-7 h-7 mx-auto rounded-md bg-primary/15 border border-primary/30 flex items-center justify-center mb-2">
              <div class="w-2.5 h-2.5 rounded-sm bg-primary"></div>
            </div>
            <div class="app-nav-active relative w-full h-8 rounded-md bg-primary/15 border border-primary/30 flex items-center justify-center">
              <LayoutDashboard class="w-3.5 h-3.5 text-primary" />
            </div>
            <div class="w-full h-8 rounded-md flex items-center justify-center hover:bg-neutral-200/40 dark:hover:bg-neutral-700/40">
              <Layers class="w-3.5 h-3.5 text-neutral-400" />
            </div>
            <div class="w-full h-8 rounded-md flex items-center justify-center hover:bg-neutral-200/40 dark:hover:bg-neutral-700/40">
              <FileText class="w-3.5 h-3.5 text-neutral-400" />
            </div>
            <div class="w-full h-8 rounded-md flex items-center justify-center hover:bg-neutral-200/40 dark:hover:bg-neutral-700/40">
              <ChartNoAxesColumnIncreasing class="w-3.5 h-3.5 text-neutral-400" />
            </div>
            <div class="flex-1"></div>
            <div class="w-7 h-7 mx-auto rounded-full bg-accent/40 border border-accent/60"></div>
          </aside>

          <!-- Main -->
          <div class="flex-1 p-4 md:p-6 flex flex-col gap-4 overflow-hidden">
            <!-- Toolbar -->
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div>
                  <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 leading-none">Live Sync Monitor</h3>
                  <p class="text-[10px] text-neutral-400 mt-1">Tenant: production-store.myshopify.com</p>
                </div>
                <span class="hidden md:inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border border-emerald-500/30 bg-emerald-500/5">
                  <span class="app-live-dot relative w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  <span class="text-[9px] uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-medium">Engine Active</span>
                </span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">SAP B1 Service Layer: <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Connected</span></span>
              </div>
            </div>

            <!-- Stat row -->
            <div class="grid grid-cols-3 gap-2 md:gap-3">
              {[
                { label: "Orders Synced (24h)", value: "342", delta: "100% Success" },
                { label: "Active SKUs", value: "12,480", delta: "In Sync" },
                { label: "Pending Queue", value: "0", delta: "Real-time" },
              ].map((s, i) => (
                <div
                  class="app-stat-card relative overflow-hidden rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 p-2 md:p-3"
                  style={`--shimmer-delay: ${i * 1.2}s;`}
                >
                  <span class="block text-[9px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400">{s.label}</span>
                  <span class="block text-sm md:text-base font-brand text-neutral-800 dark:text-neutral-100 mt-1">{s.value}</span>
                  <span class="block text-[9px] text-emerald-600 dark:text-emerald-400 mt-1">{s.delta}</span>
                </div>
              ))}
            </div>

            <!-- Table mock -->
            <div class="flex-1 rounded-lg border border-primary/10 dark:border-neutral-700 bg-bg-primary/40 dark:bg-neutral-800/40 overflow-hidden">
              <div class="grid grid-cols-12 gap-2 px-3 py-2 border-b border-primary/10 dark:border-neutral-700 text-[9px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold">
                <span class="col-span-5">Event Source / Transaction</span>
                <span class="col-span-3">Direction</span>
                <span class="col-span-2">Status</span>
                <span class="col-span-2 text-right">Latency</span>
              </div>
              {[
                { name: "Order #SH-10492 — Sales Order", flow: "Shopify → SAP B1", status: "Success", latency: "0.4s" },
                { name: "SKU-98402 — Stock Adjustment (WH-01)", flow: "SAP B1 → Shopify", status: "Updated", latency: "0.6s" },
                { name: "Order #SH-10491 — Sales Order", flow: "Shopify → SAP B1", status: "Success", latency: "0.5s" },
                { name: "PRC-MATRIX — Price Tier Matrix", flow: "SAP B1 → Shopify", status: "Synced", latency: "0.8s" },
              ].map((row, i) => (
                <div class:list={["grid grid-cols-12 gap-2 items-center px-3 py-2 border-b border-primary/5 dark:border-neutral-700/40 last:border-0", i === 0 && "app-row-cursor"]}>
                  <div class="col-span-5 flex items-center gap-2">
                    <div class={`w-2 h-2 rounded-full ${i % 2 === 0 ? 'bg-primary' : 'bg-emerald-500'}`}></div>
                    <span class="text-[11px] font-medium text-neutral-700 dark:text-neutral-200 truncate">{row.name}</span>
                    {i === 0 && <span class="app-blink-cursor inline-block w-[2px] h-3 bg-primary"></span>}
                  </div>
                  <div class="col-span-3">
                    <span class="inline-block px-1.5 py-0.5 rounded text-[9px] font-semibold bg-primary/10 text-primary">{row.flow}</span>
                  </div>
                  <div class="col-span-2">
                    <div class="inline-flex items-center gap-1">
                      <div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div>
                      <span class="text-[9px] font-medium text-emerald-600 dark:text-emerald-400">{row.status}</span>
                    </div>
                  </div>
                  <div class="col-span-2 text-right text-[10px] font-medium text-neutral-700 dark:text-neutral-200">{row.latency}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </BrowserFrame>
      <p class="text-center text-xs text-neutral-400 dark:text-neutral-500 mt-4">
        Real-time telemetry with comprehensive audit logging and automated exponential-backoff retry policies.
      </p>
    </div>
  </section>

  <!-- 7. Use Cases -->
  <section class="py-16 md:py-24 site-container">
    <SectionHeader
      title="Purpose-Built for Modern Commerce Models"
      description="Whether you run high-growth DTC brands, multi-warehouse B2B distribution networks, or SAP consulting practices."
    />
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mt-8">
      {useCases.map((uc, i) => (
        <div
          class="flex flex-col items-center p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 text-center hover:shadow-md hover:-translate-y-1 transition-all duration-300"
          data-aos="fade-up-sm"
          data-aos-delay={i * 100}
          data-aos-once="true"
        >
          <div class="w-12 h-12 rounded-xl bg-primary/10 dark:bg-primary/20 flex items-center justify-center text-primary mb-3">
            <uc.icon class="w-6 h-6" />
          </div>
          <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">{uc.label}</span>
          <span class="text-xs text-neutral-400 mt-1 leading-relaxed">{uc.desc}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- 8. Tech Stack Architecture -->
  <section class="py-16 md:py-24 site-container" data-aos="fade-up-sm" data-aos-once="true">
    <SectionHeader
      title="Cloud-Native, Resilient Technology Foundation"
      description="A proven tech stack guaranteeing data consistency, fault tolerance, and uninterrupted transaction throughput."
    />
    <div class="mt-8" data-aos="fade-up-sm" data-aos-once="true" data-aos-delay="300">
      <TechStackCard />
    </div>
  </section>

  <!-- 9. Integrations Ecosystem & Future Roadmap -->
  <section id="integrations" class="py-16 md:py-24 site-container scroll-mt-20">
    <SectionHeader
      title="Integration Ecosystem & Connectors Roadmap"
      description="Battle-tested Shopify × SAP Business One synchronization today, expanding into a universal mesh connecting multi-channel commerce with leading enterprise ERPs."
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-12">
      <!-- Commerce Platforms Card -->
      <div class="p-6 md:p-8 rounded-3xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 shadow-xs flex flex-col justify-between" data-aos="fade-up-xs" data-aos-once="true">
        <div>
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-dashed border-primary/10 dark:border-neutral-700">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                <ShoppingBag class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100">Commerce & Marketplaces</h3>
                <p class="text-xs text-neutral-500">Storefronts & Channel Ingestion</p>
              </div>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              1 Live / 4 In Pipeline
            </span>
          </div>

          <div class="space-y-3.5">
            {integrationsCommerce.map((item) => (
              <div class={`p-3.5 rounded-xl border transition-all ${item.live ? 'bg-primary/5 dark:bg-primary/10 border-primary/30' : 'bg-white/40 dark:bg-neutral-800/40 border-neutral-200 dark:border-neutral-700/60'}`}>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-neutral-900 dark:text-white flex items-center gap-2">
                    {item.live && <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>}
                    {item.name}
                  </span>
                  <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${item.live ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 font-bold' : 'bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300'}`}>
                    {item.status}
                  </span>
                </div>
                <p class="text-xs text-neutral-500 dark:text-neutral-400">{item.desc}</p>
