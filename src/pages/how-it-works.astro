---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import {
  ShoppingBag, Database, ArrowRight, ArrowLeftRight,
  Server, Cpu, ShieldCheck, RefreshCw, Zap, Boxes, CheckCheck
} from "@lucide/astro";

const steps = [
  {
    number: "01",
    title: "Install & Authorize Shopify Storefront",
    desc: "Open the B1connect installation link. Through Shopify's official OAuth flow, the embedded app installs in seconds. All access tokens are securely encrypted.",
    points: [
      "Installed via official Shopify App Bridge OAuth",
      "Credentials secured with AES-256-GCM encryption",
      "Zero theme code (Liquid/JSON) modifications required"
    ]
  },
  {
    number: "02",
    title: "Configure SAP Service Layer & Field Mappings",
    desc: "Launch the guided Setup Wizard within your Shopify admin. Enter your SAP B1 Service Layer URL, CompanyDB, and service credentials. Then map your SKUs, price lists, and fulfillment centers.",
    points: [
      "Native connection via official SAP Service Layer REST API (HANA / SQL Server)",
      "Instant Test Connection feature for real-time network validation",
      "Granular mapping for items, Units of Measure (UoM), and Price Lists",
      "Support for self-signed SSL on on-premise SAP deployments"
    ]
  },
  {
    number: "03",
    title: "Activate Automated Sync & Live Monitoring",
    desc: "Enable the synchronization engine. Inventory and catalog items from your SAP warehouses appear on Shopify, while store orders automatically generate official Sales Orders in SAP.",
    points: [
      "Automated inventory polling every 30 seconds",
      "Sub-second orders/paid webhooks generating ORDR/ODLN records",
      "Real-time monitoring dashboard and telemetry audit stream"
    ]
  }
];

const dataFlows = [
  {
    direction: "SAP Business One ➔ Shopify",
    tag: "Catalog & Inventory",
    frequency: "Automated polling every 30 seconds",
    items: [
      { name: "Item Master (OITM)", desc: "ItemCode, ItemName, descriptions, barcodes, and product media" },
      { name: "Inventory Stock (OITW)", desc: "On-hand stock levels across multiple physical warehouse facilities" },
      { name: "Price Lists (ITM1)", desc: "Tiered price matrices, multi-currency values, and promotional rates" }
    ]
  },
  {
    direction: "Shopify ➔ SAP Business One",
    tag: "Transactions & Customers",
    frequency: "Real-time webhooks (Latency < 0.5s)",
    items: [
      { name: "Sales Orders (ORDR)", desc: "Customer checkout items, quantities, taxes, discounts, and shipping" },
      { name: "Customer Master (OCRD)", desc: "Intelligent matching or automated registration of new Business Partners" },
      { name: "Delivery / Fulfillment", desc: "Fulfillment status and tracking numbers synced bi-directionally" }
    ]
  }
];

const techHighlights = [
  { icon: Cpu, title: ".NET 10 Core", desc: "High-throughput compiled backend built for massive transactional loads." },
  { icon: Server, title: "PostgreSQL", desc: "Robust relational database featuring complete multi-tenant schema isolation." },
  { icon: Zap, title: "Redis Cache", desc: "High-speed in-memory datastore for token idempotency and fast delta diffing." },
  { icon: RefreshCw, title: "Hangfire Worker", desc: "Background job orchestration with built-in dead-letter queues & auto-retries." },
  { icon: Boxes, title: "Docker Ready", desc: "Containerized architecture for rapid deployment on private VPS or public cloud." },
  { icon: ShieldCheck, title: "AES-256-GCM & HMAC", desc: "Military-grade at-rest encryption and cryptographic webhook validation." },
];
---

<Layout
  title={`How B1connect Works — ${siteConfig.title}`}
  description="Learn how B1connect connects Shopify with SAP Business One through an automated canonical middleware mesh without modifying core ERP systems."
>
  <section class="site-container my-12">
    <PageHeader
      title="How B1connect Works"
      description="From 3-step setup to automated bidirectional synchronization—built on a universal canonical pipeline connecting storefronts with enterprise ERPs."
    />
  </section>

  <!-- Section 1: Visual Architecture Diagram -->
  <section class="site-container pb-16 md:pb-24" data-aos="fade-up-xs" data-aos-once="true">
    <div class="rounded-3xl border border-primary/20 bg-bg-secondary dark:bg-bg-secondary-dark p-6 md:p-10 shadow-sm overflow-hidden">
      <div class="text-center max-w-xl mx-auto mb-8">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary mb-2">
          System Architecture
        </span>
        <h2 class="text-2xl md:text-3xl font-brand">The Intelligent Bridge Between Modern E-Commerce & Enterprise ERP</h2>
      </div>

      <!-- Diagram Nodes -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
        <!-- Node 1: Storefronts -->
        <div class="p-6 rounded-2xl bg-bg-primary/80 dark:bg-neutral-800/80 border border-primary/15 text-center flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4">
            <ShoppingBag class="w-7 h-7" />
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100">Commerce & Storefronts</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 mb-3">Shopify (Live) • Multi-Channel (Roadmap)</p>
          <div class="w-full space-y-1.5 text-[11px] font-mono text-neutral-600 dark:text-neutral-300">
            <div class="p-1.5 rounded bg-bg-secondary dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 text-emerald-600 dark:text-emerald-400 font-semibold">Shopify App Bridge & Storefront (Live)</div>
            <div class="p-1.5 rounded bg-bg-secondary dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700">WooCommerce & Marketplaces (In Pipeline)</div>
            <div class="p-1.5 rounded bg-bg-secondary dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700">Sub-second Webhook Ingestion Pipeline</div>
          </div>
        </div>

        <!-- Node 2: Canonical Integration Mesh -->
        <div class="p-6 rounded-2xl bg-gradient-to-b from-blue-600/10 to-indigo-600/10 border-2 border-primary/30 text-center flex flex-col items-center relative">
          <div class="w-14 h-14 rounded-2xl bg-primary text-white flex items-center justify-center mb-4 shadow-md shadow-primary/30">
            <ArrowLeftRight class="w-7 h-7" />
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100">B1connect Canonical Mesh</h3>
          <p class="text-xs text-primary font-semibold mt-1 mb-3">Decoupled Normalization Engine</p>
          <div class="w-full space-y-1.5 text-[11px] font-mono text-neutral-700 dark:text-neutral-200">
            <div class="p-1.5 rounded bg-bg-primary/90 dark:bg-neutral-800/90 border border-primary/20">Canonical Commerce Schema Normalizer</div>
            <div class="p-1.5 rounded bg-bg-primary/90 dark:bg-neutral-800/90 border border-primary/20">AES-256-GCM Secret Vault</div>
            <div class="p-1.5 rounded bg-bg-primary/90 dark:bg-neutral-800/90 border border-primary/20">.NET 10 + Hangfire Queue Resilience</div>
          </div>
        </div>

        <!-- Node 3: Enterprise ERPs -->
        <div class="p-6 rounded-2xl bg-bg-primary/80 dark:bg-neutral-800/80 border border-primary/15 text-center flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4">
            <Database class="w-7 h-7" />
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100">Enterprise ERP Systems</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 mb-3">SAP B1 (Live) • S/4HANA & NetSuite (Roadmap)</p>
          <div class="w-full space-y-1.5 text-[11px] font-mono text-neutral-600 dark:text-neutral-300">
            <div class="p-1.5 rounded bg-bg-secondary dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 text-blue-600 dark:text-blue-400 font-semibold">SAP B1 Service Layer REST (HANA/SQL Live)</div>
            <div class="p-1.5 rounded bg-bg-secondary dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700">SAP S/4HANA & NetSuite (In Pipeline)</div>
            <div class="p-1.5 rounded bg-bg-secondary dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700">Dynamics 365 & Odoo Adapters (Roadmap)</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: 3 Simple Steps -->
  <section class="site-container py-16 md:py-24">
    <div class="text-center max-w-2xl mx-auto mb-14" data-aos="fade-up-xs" data-aos-once="true">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">Up and Running in 3 Simple Steps</h2>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
        The onboarding process is engineered without technical complexity. Fast, secure, and validated immediately.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {steps.map((step, i) => (
        <div
          class="p-7 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 flex flex-col justify-between hover:shadow-md transition-all duration-300"
          data-aos="fade-up-sm"
          data-aos-delay={i * 120}
          data-aos-once="true"
        >
          <div>
            <div class="text-4xl font-black text-primary/30 mb-4 font-mono">{step.number}</div>
            <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 mb-2">{step.title}</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-6">{step.desc}</p>
          </div>
          <ul class="space-y-2.5 pt-4 border-t border-dashed border-primary/10 dark:border-neutral-700">
            {step.points.map((p) => (
              <li class="flex items-start gap-2 text-xs text-neutral-600 dark:text-neutral-300">
                <CheckCheck class="w-3.5 h-3.5 text-primary mt-0.5 shrink-0" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 3: Detailed Data Flow -->
  <section class="site-container py-16 md:py-24" data-aos="fade-up-xs" data-aos-once="true">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">Detailed Data Flow Pipelines</h2>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
        Both synchronization pipelines operate independently to preserve product catalog integrity and financial ledger accuracy.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {dataFlows.map((flow) => (
        <div class="p-7 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary">
              {flow.tag}
            </span>
            <span class="text-xs text-neutral-400 font-mono">{flow.frequency}</span>
          </div>
          <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 mb-5">{flow.direction}</h3>

          <div class="space-y-3">
            {flow.items.map((item) => (
              <div class="p-3.5 rounded-xl bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10">
                <div class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{item.name}</div>
                <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 leading-relaxed">{item.desc}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 4: Architecture & Security Highlights -->
  <section class="site-container py-16 md:py-24" data-aos="fade-up-xs" data-aos-once="true">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">Enterprise-Grade Technical Foundation</h2>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
        Built to satisfy demanding financial-grade security standards and cloud-native resilience requirements.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {techHighlights.map((tech) => (
        <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 hover:border-primary/30 transition-all">
          <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-3">
            <tech.icon class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-neutral-800 dark:text-neutral-100 mb-1">{tech.title}</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">{tech.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 5: Bottom CTA -->
  <section class="py-16 md:py-24 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-2xl mx-auto text-center rounded-3xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 p-8 md:p-14">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">Ready to Connect Your Systems?</h2>
      <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
        Book a live demonstration and implementation consultation with our senior integration engineers.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button url="/contact" type="fill" className="text-base px-8 py-3">
          Schedule a Free Demo <ArrowRight size={18} class="ml-1" />
        </Button>
        <Button url="/pricing" className="text-base px-8 py-3">
          View Pricing Plans
        </Button>
      </div>
    </div>
  </section>
</Layout>
