---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import {
  RefreshCw, ShoppingBag, Layers, ShieldCheck, SlidersHorizontal, Activity,
  ArrowRight, Check, CheckCheck, Database, Lock, Server, Cpu, Zap
} from "@lucide/astro";

const featureModules = [
  {
    icon: RefreshCw,
    title: "Product Master & Inventory Stock Synchronization",
    desc: "Item Masters in SAP Business One automatically publish as live products on Shopify. Multi-warehouse inventory adjustments and price list changes poll automatically every 30 seconds with zero manual CSV exports.",
    points: [
      "Automated background polling every 30 seconds",
      "Flexible attribute mapping: ItemCode → SKU, ItemName → Title, UoM conversions",
      "Multi-warehouse routing and inventory location allocation",
      "Automated Price List and currency synchronization"
    ],
    direction: "left",
    visual: "product-sync",
  },
  {
    icon: ShoppingBag,
    title: "Automated Sales Order Ingestion into SAP B1",
    desc: "Every paid checkout on Shopify is converted into a native SAP B1 Sales Order (ORDR/ODLN document) instantly via real-time webhooks without latency.",
    points: [
      "Sub-second webhooks for orders/paid and orders/create events",
      "Automatic line items, tax brackets, discounts, and shipping cost mapping",
      "Intelligent Business Partner (BP) reconciliation and customer creation",
      "Dead-letter queues and automated retries when SAP experiences peak load"
    ],
    direction: "right",
    visual: "order-sync",
  },
  {
    icon: Layers,
    title: "Native Multi-Tenancy: One Cluster for Multiple Stores",
    desc: "A true multi-tenant architecture empowers a single integration cluster to orchestrate multiple Shopify storefronts. Each merchant brand or regional branch maintains isolated configurations with 100% data privacy.",
    points: [
      "Strict database and in-memory tenant isolation",
      "Independent connections to separate SAP B1 company databases",
      "Scales effortlessly to dozens of concurrent storefronts",
      "Seamless onboarding via standard Shopify App Store OAuth"
    ],
    direction: "left",
    visual: "multi-tenant",
  },
  {
    icon: ShieldCheck,
    title: "Enterprise-Grade Cryptographic Security",
    desc: "All sensitive credentials, including Shopify private access tokens and SAP B1 Service Layer passwords, are encrypted using AES-256-GCM. Webhooks are verified using constant-time HMAC-SHA256 comparison.",
    points: [
      "AES-256-GCM encryption for all credentials stored at rest",
      "Constant-time HMAC-SHA256 signature verification for Shopify webhooks",
      "Shopify App Bridge JWT session token authentication",
      "Support for internal and self-signed SSL certificates for on-premise SAP servers"
    ],
    direction: "right",
    visual: "security",
  },
  {
    icon: SlidersHorizontal,
    title: "Guided 3-Step Setup Wizard Without Code",
    desc: "Configure the entire integration through an intuitive wizard embedded directly inside Shopify Admin. Authenticate your ERP connection, map fields, and launch auto-sync.",
    points: [
      "Step 1: Input Service Layer URL, CompanyDB, and authentication credentials",
      "Step 2: Map SKU fields, barcodes, and master price list catalogs",
      "Step 3: Map order financial accounts and default shipping warehouses",
      "Built-in Test Connection tool for immediate connectivity validation"
    ],
    direction: "left",
    visual: "wizard",
  },
  {
    icon: Activity,
    title: "Observability Dashboard & Hangfire Queue Telemetry",
    desc: "Gain complete transparency over every background job. Monitor queue throughput, inspect SAP HTTP response payloads, and track service health in real time.",
    points: [
      "Real-time sync status telemetry per connected storefront",
      "Granular transaction audit logs with full request & response payloads",
      "Integrated Hangfire dashboard for queue lifecycle management",
      "Automated health-check endpoint (/health) for uptime observability"
    ],
    direction: "right",
    visual: "dashboard",
  },
  {
    icon: Cpu,
    title: "Pluggable Universal Architecture: Built for Any Storefront, Any ERP",
    desc: "At the core of B1connect lies a Canonical Commerce Data Model. Storefront events and ERP data contracts are decoupled through normalized abstraction contracts, enabling rapid rollout of new connectors (WooCommerce, Magento, NetSuite, Dynamics 365, SAP S/4HANA) without altering core business rules.",
    points: [
      "Decoupled Canonical Domain Models for Products, Stock, Orders, and Customers",
      "Vendor-agnostic Queue Workers powered by .NET 10, Hangfire, and Redis",
      "Extensible Adapter Pattern ready for REST, SOAP, and OData ERP endpoints",
      "Strict multi-tenant security isolation across disparate ERP environments"
    ],
    direction: "left",
    visual: "multi-tenant",
  },
];
---

<Layout
  title={`Complete Features & Pluggable Architecture — ${siteConfig.title}`}
  description="Explore the core modules of B1connect powering real-time Shopify × SAP B1 synchronization, built on a pluggable universal architecture ready for any ERP."
>
  <section class="site-container my-12">
    <PageHeader
      title="Enterprise Integration Modules Built for Scale"
      description="Production-ready synchronization between Shopify and SAP B1 today, engineered with a pluggable canonical architecture expanding to global ERPs and multi-channel commerce."
    />
  </section>

  <!-- Feature Detail Modules -->
  {featureModules.map((mod) => (
    <section class="py-16 md:py-24 site-container">
      <div class={`flex flex-col ${mod.direction === 'right' ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-10 md:gap-16`}>
        <!-- Text -->
        <div class="flex-1 min-w-0" data-aos={mod.direction === 'right' ? 'fade-left-sm' : 'fade-right-sm'} data-aos-once="true">
          <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <mod.icon class="w-6 h-6 text-primary" />
          </div>
          <h2 class="text-2xl md:text-3xl font-brand mb-4">{mod.title}</h2>
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">{mod.desc}</p>
          <ul class="space-y-3">
            {mod.points.map((point) => (
              <li class="flex items-start gap-2.5">
                <Check class="w-4 h-4 text-primary mt-1 flex-shrink-0" />
                <span class="text-sm text-neutral-600 dark:text-neutral-300">{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Visual -->
        <div class="flex-1 min-w-0 w-full" data-aos={mod.direction === 'right' ? 'fade-right-sm' : 'fade-left-sm'} data-aos-delay="200" data-aos-once="true">
          <div class="relative rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 h-[290px] md:h-[350px] overflow-hidden p-6 flex flex-col justify-center">

            <!-- 1. Product & Inventory Sync Mock -->
            {mod.visual === "product-sync" && (
              <div class="h-full flex flex-col justify-between font-mono text-[11px]">
                <div class="flex items-center justify-between border-b border-dashed border-primary/20 pb-2">
                  <div class="flex items-center gap-2">
                    <Database class="w-3.5 h-3.5 text-primary" />
                    <span class="font-bold text-neutral-800 dark:text-neutral-200">SAP B1 Item Master</span>
                  </div>
                  <span class="text-[9px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold">Polling 30s</span>
                  <div class="flex items-center gap-2">
                    <ShoppingBag class="w-3.5 h-3.5 text-emerald-500" />
                    <span class="font-bold text-neutral-800 dark:text-neutral-200">Shopify Product</span>
                  </div>
                </div>

                <div class="space-y-2 py-2">
                  <div class="p-2.5 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] text-neutral-400">ItemCode: WH-NB901</div>
                      <div class="text-xs font-semibold text-neutral-700 dark:text-neutral-200">New Balance 990v6</div>
                    </div>
                    <div class="flex items-center gap-1.5 text-primary">
                      <ArrowRight class="w-3.5 h-3.5" />
                    </div>
                    <div class="text-right">
                      <div class="text-[10px] text-neutral-400">SKU: WH-NB901</div>
                      <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Sync: In Stock (84 pcs)</div>
                    </div>
                  </div>

                  <div class="p-2.5 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] text-neutral-400">PriceList #01: $249.00</div>
                      <div class="text-xs text-neutral-600 dark:text-neutral-300">Multi-Warehouse (WH-01, WH-02)</div>
                    </div>
                    <div class="flex items-center gap-1.5 text-primary">
                      <ArrowRight class="w-3.5 h-3.5" />
                    </div>
                    <div class="text-right">
                      <div class="text-[10px] text-neutral-400">Shopify Variant Price</div>
                      <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">$249.00 (Updated)</div>
                    </div>
                  </div>
                </div>

                <div class="pt-2 border-t border-dashed border-primary/20 flex items-center justify-between text-[10px] text-neutral-400">
                  <span>Delta sync: 12 SKUs updated</span>
                  <span class="text-emerald-500 font-medium flex items-center gap-1"><CheckCheck class="w-3 h-3" /> Zero mismatch</span>
                </div>
              </div>
            )}

            <!-- 2. Order Sync Mock -->
            {mod.visual === "order-sync" && (
              <div class="h-full flex flex-col justify-between font-mono text-[11px]">
                <div class="flex items-center justify-between border-b border-dashed border-primary/20 pb-2">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="font-bold text-neutral-800 dark:text-neutral-200">Webhook: orders/paid</span>
                  </div>
                  <span class="text-[10px] text-primary font-semibold">Latency: 0.42s</span>
                </div>

                <div class="my-auto p-3.5 rounded-xl bg-bg-primary/60 dark:bg-neutral-800/60 border border-primary/15 space-y-2">
                  <div class="flex justify-between items-center text-xs">
                    <span class="font-semibold text-neutral-800 dark:text-neutral-100">Shopify Order #10492</span>
                    <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold">PAID</span>
                  </div>
                  <div class="text-[11px] text-neutral-500 dark:text-neutral-400">
                    Customer: Alex Reynolds (BP CardCode: <span class="text-primary font-bold">C00291</span>)
                  </div>
                  <div class="h-px bg-dashed border-t border-neutral-200 dark:border-neutral-700 my-1.5"></div>
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-neutral-600 dark:text-neutral-300">SAP Document Created:</span>
                    <span class="font-bold text-primary">ORDR DocNum #20941</span>
                  </div>
                </div>

                <div class="pt-2 border-t border-dashed border-primary/20 flex items-center justify-between text-[10px] text-neutral-400">
                  <span>Line items: 3 items mapped</span>
                  <span class="text-emerald-500 font-semibold">Status: Document Committed</span>
                </div>
              </div>
            )}

            <!-- 3. Multi-Tenant Architecture Mock -->
            {mod.visual === "multi-tenant" && (
              <div class="h-full flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs font-semibold text-neutral-700 dark:text-neutral-200 border-b border-dashed border-primary/20 pb-2">
                  <span>B1connect Multi-Tenant Registry</span>
                  <span class="text-[10px] text-primary">3 Tenants Active</span>
                </div>

                <div class="space-y-2 my-auto">
                  {[
                    { store: "store-flagship.myshopify.com", sap: "SAP B1 [DB: SB1_CORP]", color: "border-primary/30" },
                    { store: "store-surabaya.myshopify.com", sap: "SAP B1 [DB: SB1_SBY]", color: "border-emerald-500/30" },
                    { store: "wholesale-portal.myshopify.com", sap: "SAP B1 [DB: SB1_B2B]", color: "border-accent/40" },
                  ].map((item) => (
                    <div class={`p-2.5 rounded-lg bg-bg-primary/60 dark:bg-neutral-800/60 border ${item.color} flex items-center justify-between text-xs`}>
                      <div class="flex items-center gap-2">
                        <ShoppingBag class="w-3.5 h-3.5 text-neutral-400" />
                        <span class="font-medium text-neutral-800 dark:text-neutral-200 truncate">{item.store}</span>
                      </div>
                      <div class="flex items-center gap-1.5 font-mono text-[10px] text-primary">
                        <Server class="w-3 h-3" />
                        <span>{item.sap}</span>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="pt-2 border-t border-dashed border-primary/20 text-center text-[10px] text-neutral-400">
                  100% Data Isolation & Encrypted Secrets per Tenant
                </div>
              </div>
            )}

            <!-- 4. Security & Encryption Mock -->
            {mod.visual === "security" && (
              <div class="h-full flex flex-col justify-between font-mono text-[11px]">
                <div class="flex items-center justify-between border-b border-dashed border-primary/20 pb-2">
                  <div class="flex items-center gap-1.5">
                    <Lock class="w-3.5 h-3.5 text-primary" />
                    <span class="font-bold text-neutral-800 dark:text-neutral-200">Security Architecture</span>
                  </div>
                  <span class="text-[9px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">TLS 1.3 Verified</span>
                </div>

                <div class="space-y-2 my-auto">
                  <div class="p-2 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 flex items-center justify-between">
                    <span class="text-neutral-500 dark:text-neutral-400">Credential Store:</span>
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400">AES-256-GCM (At-Rest)</span>
                  </div>
                  <div class="p-2 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 flex items-center justify-between">
                    <span class="text-neutral-500 dark:text-neutral-400">Webhook Validation:</span>
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400">HMAC-SHA256 (Constant-Time)</span>
                  </div>
                  <div class="p-2 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 flex items-center justify-between">
                    <span class="text-neutral-500 dark:text-neutral-400">Session Security:</span>
                    <span class="font-semibold text-primary">Shopify App Bridge JWT</span>
                  </div>
                </div>

                <div class="pt-2 border-t border-dashed border-primary/20 flex items-center justify-between text-[10px] text-neutral-400">
                  <span>Self-Signed SSL support for On-Premise SAP</span>
                  <CheckCheck class="w-3.5 h-3.5 text-emerald-500" />
                </div>
              </div>
            )}

            <!-- 5. Setup Wizard Mock -->
            {mod.visual === "wizard" && (
              <div class="h-full flex flex-col justify-between text-xs">
                <div class="flex items-center justify-between border-b border-dashed border-primary/20 pb-2">
                  <span class="font-semibold text-neutral-800 dark:text-neutral-200">Embedded Setup Wizard</span>
                  <span class="text-[10px] text-emerald-600 font-bold">Step 3 of 3</span>
                </div>

                <div class="space-y-2.5 my-auto">
                  <div class="flex items-center gap-3 p-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300">
                    <div class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-bold">✓</div>
                    <span class="font-medium text-[11px]">SAP Service Layer Connection (200 OK)</span>
                  </div>
                  <div class="flex items-center gap-3 p-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300">
                    <div class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-bold">✓</div>
                    <span class="font-medium text-[11px]">SKU & Master Price Field Mapping Completed</span>
                  </div>
                  <div class="flex items-center gap-3 p-2 rounded-lg bg-primary/10 border border-primary/30 text-primary">
                    <div class="w-5 h-5 rounded-full bg-primary text-white flex items-center justify-center text-[10px] font-bold">3</div>
                    <span class="font-bold text-[11px]">Configure Default Warehouse & Sales Order Ledger</span>
                  </div>
                </div>

                <div class="pt-2 border-t border-dashed border-primary/20 flex justify-between items-center text-[10px] text-neutral-400">
                  <span>Ready to sync</span>
                  <span class="text-primary font-bold">Auto-Sync Enabled</span>
                </div>
              </div>
            )}

            <!-- 6. Real-Time Dashboard & Hangfire Mock -->
            {mod.visual === "dashboard" && (
              <div class="h-full flex flex-col justify-between font-mono text-[11px]">
                <div class="flex items-center justify-between border-b border-dashed border-primary/20 pb-2">
                  <div class="flex items-center gap-1.5">
                    <Cpu class="w-3.5 h-3.5 text-primary" />
                    <span class="font-bold text-neutral-800 dark:text-neutral-200">Hangfire Engine Metrics</span>
                  </div>
                  <span class="text-[9px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">Workers: 4 Active</span>
                </div>

                <div class="grid grid-cols-3 gap-2 my-auto">
                  <div class="p-2 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 text-center">
                    <div class="text-[9px] text-neutral-400 uppercase">Jobs Done</div>
                    <div class="text-sm font-bold text-neutral-800 dark:text-neutral-100">18,429</div>
                  </div>
                  <div class="p-2 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 text-center">
                    <div class="text-[9px] text-neutral-400 uppercase">Failed</div>
                    <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">0</div>
                  </div>
                  <div class="p-2 rounded-lg bg-bg-primary/50 dark:bg-neutral-800/50 border border-primary/10 text-center">
                    <div class="text-[9px] text-neutral-400 uppercase">Avg Latency</div>
                    <div class="text-sm font-bold text-primary">0.62s</div>
                  </div>
                </div>

                <div class="pt-2 border-t border-dashed border-primary/20 flex items-center justify-between text-[10px] text-neutral-400">
                  <span class="flex items-center gap-1"><Zap class="w-3 h-3 text-amber-500" /> Redis Cache Hit: 99.4%</span>
                  <span class="text-emerald-500 font-bold">Health: 200 OK</span>
                </div>
              </div>
            )}

          </div>
        </div>
      </div>
    </section>
  ))}

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- CTA -->
  <section class="py-16 md:py-24 site-container" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-brand mb-4">Ready to Connect Your Shopify Storefront?</h2>
      <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
        Schedule a live demonstration and discover how B1connect saves your team hundreds of manual operational hours every month.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button url="/contact" type="fill" className="text-base px-8 py-3">
          Book a Live Demo <ArrowRight size={18} class="ml-1" />
        </Button>
        <Button url="/pricing" className="text-base px-8 py-3">
          View Pricing Plans
        </Button>
      </div>
    </div>
  </section>
</Layout>
